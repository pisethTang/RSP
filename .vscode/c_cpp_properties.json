{
  "configurations": [
    {
      "name": "linux-gcc-x64",
      "includePath": [
        "${workspaceFolder}/**"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "${default}",
      "cppStandard": "${default}",
      "intelliSenseMode": "linux-gcc-x64",
      "compilerArgs": [
        ""
      ]
    }
  ],
  "version": 4,

  "PrintToConsole": {
        "prefix": "std",
        "body": [
          "std::cout << $1 << std::endl;",
          "$2"
        ],
        "description": "Print to console using std::cout"
      }
}
